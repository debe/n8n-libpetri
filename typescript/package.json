{
  "name": "n8n-libpetri",
  "version": "0.1.0",
  "description": "n8n workflow scheduler replaced by a libpetri Coloured Time Petri Net engine",
  "private": true,
  "homepage": "https://github.com/debe/n8n-libpetri",
  "repository": {
    "type": "git",
    "url": "https://github.com/debe/n8n-libpetri.git",
    "directory": "typescript"
  },
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "n8n-libpetri": "./dist/verify/main.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./compiler": {
      "import": "./dist/compiler/index.js",
      "types": "./dist/compiler/index.d.ts"
    },
    "./verify": {
      "import": "./dist/verify/index.js",
      "types": "./dist/verify/index.d.ts"
    },
    "./verify/cli": {
      "import": "./dist/verify/cli.js",
      "types": "./dist/verify/cli.d.ts"
    },
    "./conformance": {
      "import": "./dist/conformance/index.js",
      "types": "./dist/conformance/index.d.ts"
    },
    "./codec": {
      "import": "./dist/codec.js",
      "types": "./dist/codec.d.ts"
    },
    "./n8n-vitest-setup": {
      "import": "./dist/n8n-vitest-setup.js",
      "types": "./dist/n8n-vitest-setup.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run"
  },
  "dependencies": {
    "libpetri": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "n8n-workflow": "^2.16.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
