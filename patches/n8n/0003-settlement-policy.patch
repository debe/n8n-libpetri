--- /dev/null
+++ b/packages/@n8n/engine/src/execution/__tests__/settlement-policy.test.ts
@@ -0,0 +1,530 @@
+import { describe, expect, it, vi } from 'vitest';
+
+import type { GraphEdge, WorkflowGraph } from '../../graph';
+import { deriveLoops, getDescendantNodeIds } from '../../graph';
+import type { LifecycleEventPublisher } from '../../lifecycle-events';
+import type { ExecutionResponseSender } from '../../response-channel';
+import { countExpectedSettledSteps } from '../completion';
+import type { ExecutionRecord, ExecutionStore } from '../execution-store';
+import { isSettledStatus, stepKeyId, type StepKey, type StepStatus } from '../execution.types';
+import { decideSuccessors, type SuccessorDecisions } from '../settlement';
+import {
+	defaultSettlementPolicy,
+	settlementReaderFor,
+	terminalIterationsOf,
+	type SettlementPolicy,
+	type SettlementReader,
+} from '../settlement-policy';
+import { StepSettledHandler } from '../step-settled-handler';
+import type { StepRecord, StepStore, StepSummary } from '../step-store';
+
+function makeGraph(
+	edges: Array<Partial<GraphEdge> & Pick<GraphEdge, 'from' | 'to'>>,
+	batchNodeIds: string[] = [],
+): WorkflowGraph {
+	const nodeIds = [...new Set(edges.flatMap(({ from, to }) => [from, to]))];
+	return {
+		nodes: nodeIds.map((id) => ({
+			id,
+			name: id.toUpperCase(),
+			type: id === 'trigger' ? 'trigger' : batchNodeIds.includes(id) ? 'batch' : 'v1-node',
+		})),
+		edges: edges.map((edge) => ({ outputIndex: 0, inputIndex: 0, ...edge })),
+	};
+}
+
+/** trigger -> if -> {a (out 0), b (out 1)} -> m: the conditional diamond. */
+const diamond = makeGraph([
+	{ from: 'trigger', to: 'if' },
+	{ from: 'if', to: 'a', outputIndex: 0 },
+	{ from: 'if', to: 'b', outputIndex: 1 },
+	{ from: 'a', to: 'm', inputIndex: 0 },
+	{ from: 'b', to: 'm', inputIndex: 1 },
+]);
+
+/**
+ * trigger -> B, a batch node: its loop slot (out 1) runs x, which returns to
+ * B; its done slot (out 0) runs d once the loop has ended. `u -> U -> u` is a
+ * second loop the trigger cannot reach.
+ */
+const looped = makeGraph(
+	[
+		{ from: 'trigger', to: 'B' },
+		{ from: 'B', to: 'x', outputIndex: 1 },
+		{ from: 'x', to: 'B', isBackEdge: true },
+		{ from: 'B', to: 'd', outputIndex: 0 },
+		{ from: 'U', to: 'u', outputIndex: 1 },
+		{ from: 'u', to: 'U', isBackEdge: true },
+	],
+	['B', 'U'],
+);
+
+function at(
+	nodeId: string,
+	iteration: number,
+	status: StepStatus,
+	filledOutputSlots: boolean[] = [],
+): StepSummary {
+	return { id: `step-${nodeId}-${iteration}`, nodeId, iteration, status, filledOutputSlots };
+}
+
+const key = (nodeId: string, iteration = 0): StepKey => ({ nodeId, iteration });
+
+function byKey(rows: StepSummary[]): Record<string, StepSummary> {
+	return Object.fromEntries(rows.map((row) => [stepKeyId(row), row]));
+}
+
+/** The latest row of each node, as the store's query returns it. */
+function latestOf(rows: StepSummary[], nodeIds: string[]): Record<string, StepSummary> {
+	const latest: Record<string, StepSummary> = {};
+	for (const row of rows) {
+		if (!nodeIds.includes(row.nodeId)) continue;
+		const seen = latest[row.nodeId];
+		if (!seen || seen.iteration < row.iteration) latest[row.nodeId] = row;
+	}
+	return latest;
+}
+
+/** The three planning reads over a fixed row set, like the store: absent keys are absent. */
+function makeReader(rows: StepSummary[]) {
+	const settled = rows.filter((row) => isSettledStatus(row.status)).length;
+	return {
+		executionId: 'exec-1',
+		loadLatestStepSummaries: vi.fn(async (nodeIds: string[]) => {
+			await Promise.resolve();
+			return latestOf(rows, nodeIds);
+		}),
+		loadStepSummariesByKeys: vi.fn(async (keys: StepKey[]) => {
+			await Promise.resolve();
+			const all = byKey(rows);
+			return Object.fromEntries(
+				keys.map(stepKeyId).flatMap((id) => (all[id] ? [[id, all[id]]] : [])),
+			) as Record<string, StepSummary>;
+		}),
+		countSettledSteps: vi.fn(async () => {
+			await Promise.resolve();
+			return settled;
+		}),
+	} satisfies SettlementReader;
+}
+
+/** `decideSuccessors` called directly, with every row and every loop's terminal pass. */
+function decideDirectly(graph: WorkflowGraph, settled: StepKey, rows: StepSummary[]) {
+	const loops = deriveLoops(graph);
+	const latest = latestOf(
+		rows,
+		loops.map((loop) => loop.batchNodeId),
+	);
+	return decideSuccessors(graph, loops, settled, byKey(rows), terminalIterationsOf(latest));
+}
+
+describe('defaultSettlementPolicy.decideSuccessors', () => {
+	const cases: Array<{
+		name: string;
+		graph: WorkflowGraph;
+		settled: StepKey;
+		rows: StepSummary[];
+		expected: SuccessorDecisions;
+	}> = [
+		{
+			name: 'a branch decides its live and dead successors',
+			graph: diamond,
+			settled: key('if'),
+			rows: [at('trigger', 0, 'completed', [true]), at('if', 0, 'completed', [true, false])],
+			expected: { toQueue: [key('a')], toSkip: [key('b')] },
+		},
+		{
+			name: 'a merge waits for its other input',
+			graph: diamond,
+			settled: key('a'),
+			rows: [
+				at('trigger', 0, 'completed', [true]),
+				at('if', 0, 'completed', [true, true]),
+				at('a', 0, 'completed', [true]),
+				at('b', 0, 'queued'),
+			],
+			expected: { toQueue: [], toSkip: [] },
+		},
+		{
+			name: 'an existing row is not decided again',
+			graph: diamond,
+			settled: key('b'),
+			rows: [
+				at('trigger', 0, 'completed', [true]),
+				at('if', 0, 'completed', [true, true]),
+				at('a', 0, 'completed', [true]),
+				at('b', 0, 'completed', [true]),
+				at('m', 0, 'queued'),
+			],
+			expected: { toQueue: [], toSkip: [] },
+		},
+		{
+			name: 'a running loop decides its body',
+			graph: looped,
+			settled: key('B', 1),
+			rows: [
+				at('trigger', 0, 'completed', [true]),
+				at('B', 0, 'completed', [false, true]),
+				at('x', 0, 'completed', [true]),
+				at('B', 1, 'completed', [false, true]),
+			],
+			expected: { toQueue: [key('x', 1)], toSkip: [] },
+		},
+		{
+			name: 'the body returns to the next pass',
+			graph: looped,
+			settled: key('x', 1),
+			rows: [
+				at('trigger', 0, 'completed', [true]),
+				at('B', 0, 'completed', [false, true]),
+				at('x', 0, 'completed', [true]),
+				at('B', 1, 'completed', [false, true]),
+				at('x', 1, 'completed', [true]),
+			],
+			expected: { toQueue: [key('B', 2)], toSkip: [] },
+		},
+		{
+			name: 'the terminal pass decides what follows the loop',
+			graph: looped,
+			settled: key('B', 1),
+			rows: [
+				at('trigger', 0, 'completed', [true]),
+				at('B', 0, 'completed', [false, true]),
+				at('x', 0, 'completed', [true]),
+				at('B', 1, 'completed', [true, false]),
+			],
+			expected: { toQueue: [key('d')], toSkip: [] },
+		},
+	];
+
+	it.each(cases)(
+		'equals the direct call when $name',
+		async ({ graph, settled, rows, expected }) => {
+			const reader = makeReader(rows);
+
+			const decisions = await defaultSettlementPolicy.decideSuccessors(graph, settled, reader);
+
+			expect(decisions).toEqual(decideDirectly(graph, settled, rows));
+			expect(decisions).toEqual(expected);
+		},
+	);
+
+	it('reads the decision rows in one query, and no loop tip when no exit edge is resolved', async () => {
+		const reader = makeReader(cases[0].rows);
+
+		await defaultSettlementPolicy.decideSuccessors(diamond, key('if'), reader);
+
+		expect(reader.loadLatestStepSummaries).not.toHaveBeenCalled();
+		expect(reader.loadStepSummariesByKeys).toHaveBeenCalledOnce();
+		expect(reader.countSettledSteps).not.toHaveBeenCalled();
+	});
+
+	it('reads the tip of the loop an exit edge leaves, then the decision rows', async () => {
+		const reader = makeReader(cases[5].rows);
+
+		await defaultSettlementPolicy.decideSuccessors(looped, key('B', 1), reader);
+
+		expect(reader.loadLatestStepSummaries).toHaveBeenCalledExactlyOnceWith(['B']);
+		expect(reader.loadStepSummariesByKeys).toHaveBeenCalledOnce();
+		expect(reader.loadLatestStepSummaries.mock.invocationCallOrder[0]).toBeLessThan(
+			reader.loadStepSummariesByKeys.mock.invocationCallOrder[0],
+		);
+	});
+});
+
+describe('defaultSettlementPolicy.isFinished', () => {
+	/** The count test called directly, with every row. */
+	function finishedDirectly(graph: WorkflowGraph, rows: StepSummary[]): boolean {
+		const loops = deriveLoops(graph);
+		const reachable = new Set(['trigger', ...getDescendantNodeIds(graph, 'trigger')]);
+		const latest = latestOf(
+			rows,
+			loops.map((loop) => loop.batchNodeId),
+		);
+		const expected = countExpectedSettledSteps(loops, reachable, terminalIterationsOf(latest));
+		const settled = rows.filter((row) => isSettledStatus(row.status)).length;
+		return expected !== undefined && settled >= expected;
+	}
+
+	const cases: Array<{
+		name: string;
+		graph: WorkflowGraph;
+		rows: StepSummary[];
+		expected: boolean;
+	}> = [
+		{
+			name: 'a step is still queued',
+			graph: diamond,
+			rows: [
+				at('trigger', 0, 'completed', [true]),
+				at('if', 0, 'completed', [true, false]),
+				at('a', 0, 'queued'),
+				at('b', 0, 'skipped'),
+			],
+			expected: false,
+		},
+		{
+			name: 'every reachable step has settled',
+			graph: diamond,
+			rows: [
+				at('trigger', 0, 'completed', [true]),
+				at('if', 0, 'completed', [true, false]),
+				at('a', 0, 'completed', [true]),
+				at('b', 0, 'skipped'),
+				at('m', 0, 'completed', [true]),
+			],
+			expected: true,
+		},
+		{
+			name: 'a loop is between two passes',
+			graph: looped,
+			rows: [
+				at('trigger', 0, 'completed', [true]),
+				at('B', 0, 'completed', [false, true]),
+				at('x', 0, 'completed', [true]),
+			],
+			expected: false,
+		},
+		{
+			name: 'the loop has ended and what follows it has settled',
+			graph: looped,
+			rows: [
+				at('trigger', 0, 'completed', [true]),
+				at('B', 0, 'completed', [false, true]),
+				at('x', 0, 'completed', [true]),
+				at('B', 1, 'completed', [true, false]),
+				at('d', 0, 'completed', [true]),
+			],
+			expected: true,
+		},
+	];
+
+	it.each(cases)('equals the count test when $name', async ({ graph, rows, expected }) => {
+		const reader = makeReader(rows);
+
+		const finished = await defaultSettlementPolicy.isFinished(graph, reader);
+
+		expect(finished).toBe(finishedDirectly(graph, rows));
+		expect(finished).toBe(expected);
+	});
+
+	it('is true once the settled count reaches the expected one', async () => {
+		const reader = makeReader(cases[1].rows);
+
+		expect(await defaultSettlementPolicy.isFinished(diamond, reader)).toBe(true);
+		expect(reader.loadLatestStepSummaries).not.toHaveBeenCalled();
+		expect(reader.countSettledSteps).toHaveBeenCalledOnce();
+	});
+
+	it('does not count while a reachable loop is running, and never reads an unreachable one', async () => {
+		const reader = makeReader(cases[2].rows);
+
+		expect(await defaultSettlementPolicy.isFinished(looped, reader)).toBe(false);
+		expect(reader.loadLatestStepSummaries).toHaveBeenCalledExactlyOnceWith(['B']);
+		expect(reader.countSettledSteps).not.toHaveBeenCalled();
+	});
+
+	it('rejects a graph with no trigger before reading anything', async () => {
+		const reader = makeReader([]);
+		const triggerless = makeGraph([{ from: 'a', to: 'b' }]);
+
+		await expect(defaultSettlementPolicy.isFinished(triggerless, reader)).rejects.toMatchObject({
+			name: 'UnexpectedError',
+			message: 'Execution exec-1 has no trigger node in its graph',
+		});
+		expect(reader.loadLatestStepSummaries).not.toHaveBeenCalled();
+		expect(reader.countSettledSteps).not.toHaveBeenCalled();
+	});
+});
+
+describe('settlementReaderFor', () => {
+	it("passes each read through to the store, bound to the execution's id", async () => {
+		const latest = { B: at('B', 2, 'completed', [true, false]) };
+		const rows = { 'x:0': at('x', 0, 'completed', [true]) };
+		const stepStore = {
+			loadLatestStepSummaries: vi.fn().mockResolvedValue(latest),
+			loadStepSummariesByKeys: vi.fn().mockResolvedValue(rows),
+			countSettledSteps: vi.fn().mockResolvedValue(7),
+		} as unknown as StepStore;
+
+		const reader = settlementReaderFor(stepStore, 'exec-9');
+
+		expect(reader.executionId).toBe('exec-9');
+		expect(await reader.loadLatestStepSummaries(['B'])).toBe(latest);
+		expect(stepStore.loadLatestStepSummaries).toHaveBeenCalledExactlyOnceWith('exec-9', ['B']);
+		expect(await reader.loadStepSummariesByKeys([key('x')])).toBe(rows);
+		expect(stepStore.loadStepSummariesByKeys).toHaveBeenCalledExactlyOnceWith('exec-9', [key('x')]);
+		expect(await reader.countSettledSteps()).toBe(7);
+		expect(stepStore.countSettledSteps).toHaveBeenCalledExactlyOnceWith('exec-9');
+	});
+});
+
+describe('terminalIterationsOf', () => {
+	it('keeps the loops whose latest row settled without filling the loop slot', () => {
+		expect(
+			terminalIterationsOf({
+				B: at('B', 2, 'completed', [true, false]),
+				C: at('C', 1, 'completed', [false, true]),
+				D: at('D', 0, 'running'),
+				E: at('E', 3, 'skipped'),
+			}),
+		).toEqual(
+			new Map([
+				['B', 2],
+				['E', 3],
+			]),
+		);
+	});
+});
+
+describe('StepSettledHandler with an injected policy', () => {
+	const graph = makeGraph([
+		{ from: 'trigger', to: 'a' },
+		{ from: 'a', to: 'b' },
+		{ from: 'a', to: 'c', outputIndex: 1 },
+	]);
+
+	function setup(policy: SettlementPolicy, { failed = false } = {}) {
+		const execution: ExecutionRecord = {
+			id: 'exec-1',
+			workflowId: 'wf-1',
+			status: 'running',
+			mode: 'production',
+			graph,
+			workflow: {},
+			triggerOutputs: null,
+			callerContext: { hostMode: 'trigger' },
+			responseExpectation: { kind: 'none' },
+			finishedAt: null,
+		};
+		const step: StepRecord = {
+			id: 'step-a',
+			executionId: 'exec-1',
+			nodeId: 'a',
+			iteration: 0,
+			status: 'completed',
+			outputs: null,
+			waitDeclaration: null,
+			resumeCause: null,
+		};
+		const executionStore = {
+			loadExecution: vi.fn().mockResolvedValue(execution),
+			finishExecution: vi
+				.fn()
+				.mockResolvedValue({ finishedAt: new Date('2026-10-03T08:00:00.000Z') }),
+			refreshLiveStatus: vi.fn(),
+		} as unknown as ExecutionStore;
+		const stepStore = {
+			loadStep: vi.fn().mockResolvedValue(step),
+			createSteps: vi.fn(async (_: string, records: StepKey[]) => {
+				await Promise.resolve();
+				return records.map(({ nodeId, iteration }) => ({
+					id: `step-${nodeId}`,
+					nodeId,
+					iteration,
+				}));
+			}),
+			loadLatestStepSummaries: vi.fn().mockResolvedValue({}),
+			loadStepSummariesByKeys: vi.fn().mockResolvedValue({}),
+			countSettledSteps: vi.fn().mockResolvedValue(0),
+			hasFailedSteps: vi.fn().mockResolvedValue(failed),
+			cancelPendingSteps: vi.fn(),
+		} as unknown as StepStore;
+		const stepQueue = { publish: vi.fn(), start: vi.fn(), stop: vi.fn() };
+		const orchestrationQueue = { publish: vi.fn(), start: vi.fn(), stop: vi.fn() };
+		const publisher = { publish: vi.fn(), stop: vi.fn() } as LifecycleEventPublisher;
+		const responseSender = { send: vi.fn() } as unknown as ExecutionResponseSender;
+		const handler = new StepSettledHandler(
+			executionStore,
+			stepStore,
+			stepQueue,
+			orchestrationQueue,
+			publisher,
+			responseSender,
+			policy,
+		);
+		return { handler, step, executionStore, stepStore, stepQueue, orchestrationQueue };
+	}
+
+	const event = { type: 'step:settled', executionId: 'exec-1', stepId: 'step-a' } as const;
+
+	it("writes and announces the policy's decisions, not the default's", async () => {
+		const policy: SettlementPolicy = {
+			decideSuccessors: vi.fn().mockResolvedValue({ toQueue: [key('c')], toSkip: [key('b')] }),
+			isFinished: vi.fn().mockResolvedValue(true),
+		};
+		const { handler, step, stepStore, stepQueue, orchestrationQueue, executionStore } =
+			setup(policy);
+
+		await handler.handle(event);
+
+		expect(policy.decideSuccessors).toHaveBeenCalledExactlyOnceWith(
+			graph,
+			step,
+			expect.objectContaining({ executionId: 'exec-1' }),
+		);
+		expect(stepStore.loadStepSummariesByKeys).not.toHaveBeenCalled();
+		expect(stepStore.createSteps).toHaveBeenCalledExactlyOnceWith('exec-1', [
+			{ nodeId: 'c', iteration: 0, status: 'queued' },
+			{ nodeId: 'b', iteration: 0, status: 'skipped' },
+		]);
+		expect(stepQueue.publish).toHaveBeenCalledExactlyOnceWith({
+			type: 'step:ready',
+			executionId: 'exec-1',
+			stepId: 'step-c',
+		});
+		expect(orchestrationQueue.publish).toHaveBeenCalledExactlyOnceWith({
+			type: 'step:settled',
+			executionId: 'exec-1',
+			stepId: 'step-b',
+		});
+		// it queued work, so completion is not asked
+		expect(policy.isFinished).not.toHaveBeenCalled();
+		expect(executionStore.finishExecution).not.toHaveBeenCalled();
+	});
+
+	it('finishes the execution when the policy says it is finished', async () => {
+		const policy: SettlementPolicy = {
+			decideSuccessors: vi.fn().mockResolvedValue({ toQueue: [], toSkip: [] }),
+			isFinished: vi.fn().mockResolvedValue(true),
+		};
+		const { handler, stepStore, executionStore } = setup(policy);
+
+		await handler.handle(event);
+
+		expect(policy.isFinished).toHaveBeenCalledExactlyOnceWith(
+			graph,
+			expect.objectContaining({ executionId: 'exec-1' }),
+		);
+		expect(stepStore.countSettledSteps).not.toHaveBeenCalled();
+		expect(executionStore.finishExecution).toHaveBeenCalledExactlyOnceWith('exec-1', 'completed');
+	});
+
+	it('leaves the execution running when the policy says it is not finished', async () => {
+		const policy: SettlementPolicy = {
+			decideSuccessors: vi.fn().mockResolvedValue({ toQueue: [], toSkip: [] }),
+			isFinished: vi.fn().mockResolvedValue(false),
+		};
+		const { handler, executionStore } = setup(policy);
+
+		await handler.handle(event);
+
+		expect(executionStore.finishExecution).not.toHaveBeenCalled();
+		expect(executionStore.refreshLiveStatus).toHaveBeenCalledExactlyOnceWith('exec-1');
+	});
+
+	it('keeps the failure branch in the handler: a failed execution never asks the policy', async () => {
+		const policy: SettlementPolicy = {
+			decideSuccessors: vi.fn(),
+			isFinished: vi.fn(),
+		};
+		const { handler, stepStore, executionStore } = setup(policy, { failed: true });
+
+		await handler.handle(event);
+
+		expect(policy.decideSuccessors).not.toHaveBeenCalled();
+		expect(policy.isFinished).not.toHaveBeenCalled();
+		expect(executionStore.finishExecution).toHaveBeenCalledExactlyOnceWith('exec-1', 'failed');
+		expect(stepStore.cancelPendingSteps).toHaveBeenCalledExactlyOnceWith('exec-1');
+	});
+});
diff --git a/packages/@n8n/engine/src/execution/index.ts b/packages/@n8n/engine/src/execution/index.ts
index fa3fc87bb9..4ee2365ad3 100644
