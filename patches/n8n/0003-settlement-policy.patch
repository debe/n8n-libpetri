+import { UnexpectedError } from '../common';
+import {
+	deriveLoops,
+	findTriggerNode,
+	getDescendantNodeIds,
+	getSuccessorNodeIds,
+	type WorkflowGraph,
+} from '../graph';
+import { countExpectedSettledSteps } from './completion';
+import type { StepKey, StepKeyId } from './execution.types';
+import { exitSourcesInto, isTerminalStep } from './loop-ledger';
+import { decideSuccessors, decisionKeys, type SuccessorDecisions } from './settlement';
+import type { StepStore, StepSummary } from './step-store';
+
+/**
+ * The planning reads of one execution's step rows, and nothing else.
+ *
+ * Bound to the execution, so a policy cannot read another one's rows, and
+ * read-only, so a policy cannot write any: deciding stays a function of the
+ * rows read. Each method is the `StepStore` method of the same name.
+ */
+export interface SettlementReader {
+	readonly executionId: string;
+	loadLatestStepSummaries(nodeIds: string[]): Promise<Record<string, StepSummary>>;
+	loadStepSummariesByKeys(keys: StepKey[]): Promise<Record<StepKeyId, StepSummary>>;
+	countSettledSteps(): Promise<number>;
+}
+
+/**
+ * The two decisions `StepSettledHandler` takes from the step rows: what a
+ * settlement decides for its direct successors, and whether the execution owes
+ * no further step.
+ *
+ * Everything else stays in the handler: the failure branch, writing and
+ * announcing the decided rows, and recording the outcome. A policy reads rows
+ * through the reader it is handed and writes nothing.
+ */
+export interface SettlementPolicy {
+	/**
+	 * The successor steps the settlement of `settled` decides, as
+	 * `decideSuccessors` returns them: in edge order, and leaving out every step
+	 * that already has a row.
+	 */
+	decideSuccessors(
+		graph: WorkflowGraph,
+		settled: StepKey,
+		reader: SettlementReader,
+	): Promise<SuccessorDecisions>;
+
+	/** Whether every step the execution owes has settled. */
+	isFinished(graph: WorkflowGraph, reader: SettlementReader): Promise<boolean>;
+}
+
+/** The planning reads of `stepStore`, bound to one execution. */
+export function settlementReaderFor(stepStore: StepStore, executionId: string): SettlementReader {
+	return {
+		executionId,
+		loadLatestStepSummaries: async (nodeIds) =>
+			await stepStore.loadLatestStepSummaries(executionId, nodeIds),
+		loadStepSummariesByKeys: async (keys) =>
+			await stepStore.loadStepSummariesByKeys(executionId, keys),
+		countSettledSteps: async () => await stepStore.countSettledSteps(executionId),
+	};
+}
+
+/**
+ * The terminal iteration of each loop whose latest batch row is given, by batch
+ * node id, leaving out the loops that have not ended. `loadTerminalIterations`
+ * without the store.
+ */
+export function terminalIterationsOf(latest: Record<string, StepSummary>): Map<string, number> {
+	const terminalIterations = new Map<string, number>();
+	for (const [batchNodeId, step] of Object.entries(latest)) {
+		if (isTerminalStep(step)) terminalIterations.set(batchNodeId, step.iteration);
+	}
+	return terminalIterations;
+}
+
+/** As `loadTerminalIterations`: no read when no loop is asked about. */
+async function loadTerminalIterations(
+	reader: SettlementReader,
+	batchNodeIds: string[],
+): Promise<Map<string, number>> {
+	if (batchNodeIds.length === 0) return new Map();
+	return terminalIterationsOf(await reader.loadLatestStepSummaries(batchNodeIds));
+}
+
+function reachableNodeIds(graph: WorkflowGraph, executionId: string): Set<string> {
+	const trigger = findTriggerNode(graph);
+	if (!trigger) {
+		// The start boundary rejects triggerless graphs, so this execution
+		// should never have been created.
+		throw new UnexpectedError(`Execution ${executionId} has no trigger node in its graph`);
+	}
+	return new Set([trigger.id, ...getDescendantNodeIds(graph, trigger.id)]);
+}
+
+/** The settlement rules of `settlement.ts` and the count of `completion.ts`. */
+export const defaultSettlementPolicy: SettlementPolicy = {
+	async decideSuccessors(graph, settled, reader) {
+		const loops = deriveLoops(graph);
+		// Only the candidates' own edges are resolved, so only the loops those
+		// edges leave need their latest row read.
+		const candidates = getSuccessorNodeIds(graph, settled.nodeId);
+		const terminalIterations = await loadTerminalIterations(
+			reader,
+			exitSourcesInto(graph, loops, candidates),
+		);
+		const steps = await reader.loadStepSummariesByKeys(
+			decisionKeys(graph, loops, settled, terminalIterations),
+		);
+		return decideSuccessors(graph, loops, settled, steps, terminalIterations);
+	},
+
+	/**
+	 * Steps are unique per `(node, iteration)`, only exist for reachable nodes,
+	 * and never unsettle, so the count comparison cannot pass early — in-flight
+	 * events and unplanned successors both leave steps outstanding.
+	 */
+	async isFinished(graph, reader) {
+		const reachable = reachableNodeIds(graph, reader.executionId);
+		const loops = deriveLoops(graph);
+		const terminalIterations = await loadTerminalIterations(
+			reader,
+			// A loop the trigger cannot reach never receives rows, and the count below
+			// leaves it out, so its tip is not worth asking for.
+			loops
+				.filter((loop) => reachable.has(loop.batchNodeId))
+				.map((loop) => loop.batchNodeId),
+		);
+		const expected = countExpectedSettledSteps(loops, reachable, terminalIterations);
+		// A loop still running owes an unknown number of steps, so there is nothing
+		// to compare against yet.
+		if (expected === undefined) return false;
+
+		return (await reader.countSettledSteps()) >= expected;
+	},
+};
