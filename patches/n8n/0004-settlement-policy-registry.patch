 import { AllowAllAdmittance } from '../../admittance';
 import { mintIdentityToken, SharedSecretIdentityVerifier } from '../../auth';
 import type { EngineStores } from '../../database';
+import type * as Execution from '../../execution';
 import { BatchingLifecycleEventPublisher } from '../../lifecycle-events';
 import { noopExecutionResponseSender } from '../../response-channel';
 import { createEngineRuntime } from '../create-engine-runtime';
@@ -119,3 +120,92 @@ describe('createEngineRuntime', () => {
 		await expect(engine.stop()).resolves.toBeUndefined();
 	});
 });
+
+describe('createEngineRuntime settlement policy', () => {
+	const policy = (): Execution.SettlementPolicy => ({
+		decideSuccessors: vi.fn(),
+		isFinished: vi.fn(),
+	});
+
+	/**
+	 * A fresh module graph whose `StepSettledHandler` records the policy it is
+	 * built with. The registry is that graph's own, so registering on it is
+	 * what the runtime reads.
+	 */
+	async function load() {
+		const given: unknown[] = [];
+		vi.resetModules();
+		vi.doMock('../../execution', async (importOriginal) => {
+			const actual = await importOriginal<typeof Execution>();
+			class RecordingStepSettledHandler extends actual.StepSettledHandler {
+				constructor(...args: ConstructorParameters<typeof actual.StepSettledHandler>) {
+					super(...args);
+					given.push(args[6]);
+				}
+			}
+			return { ...actual, StepSettledHandler: RecordingStepSettledHandler };
+		});
+		const execution = await import('../../execution/index.js');
+		const { createEngineRuntime: build } = await import('../create-engine-runtime.js');
+		const create = (settlementPolicy?: Execution.SettlementPolicy) =>
+			build({
+				dataSource: fakeDataSource(),
+				admittance: new AllowAllAdmittance(),
+				identityVerifier,
+				responseSender,
+				settlementPolicy,
+			});
+		return { execution, create, given };
+	}
+
+	afterEach(() => {
+		vi.doUnmock('../../execution');
+		vi.resetModules();
+	});
+
+	it('hands the settled-step handler the default policy while none is registered', async () => {
+		const { execution, create, given } = await load();
+
+		create();
+
+		expect(given).toEqual([execution.defaultSettlementPolicy]);
+		expect(execution.getSettlementPolicy()).toBe(execution.defaultSettlementPolicy);
+	});
+
+	it('hands the settled-step handler the settlementPolicy option', async () => {
+		const { create, given } = await load();
+		const option = policy();
+
+		create(option);
+
+		expect(given).toHaveLength(1);
+		expect(given[0]).toBe(option);
+	});
+
+	it('hands the settled-step handler the registered policy when the options name none', async () => {
+		const { execution, create, given } = await load();
+		const registered = policy();
+
+		execution.setSettlementPolicy(registered);
+		create();
+		execution.resetSettlementPolicy();
+		create();
+
+		expect(given).toHaveLength(2);
+		expect(given[0]).toBe(registered);
+		expect(given[1]).toBe(execution.defaultSettlementPolicy);
+	});
+
+	it('prefers the settlementPolicy option over the registered policy', async () => {
+		const { execution, create, given } = await load();
+		const registered = policy();
+		const option = policy();
+
+		execution.setSettlementPolicy(registered);
+		create(option);
+		execution.resetSettlementPolicy();
+
+		expect(given).toHaveLength(1);
+		expect(given[0]).toBe(option);
+	});
+});
