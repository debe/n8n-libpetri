diff --git a/packages/@n8n/engine/src/execution/settlement-policy-registry.ts b/packages/@n8n/engine/src/execution/settlement-policy-registry.ts
new file mode 100644
index 0000000000..036db5a56c
--- /dev/null
+++ b/packages/@n8n/engine/src/execution/settlement-policy-registry.ts
@@ -0,0 +1,24 @@
+import { defaultSettlementPolicy, type SettlementPolicy } from './settlement-policy';
+
+let policy: SettlementPolicy = defaultSettlementPolicy;
+
+/**
+ * Replace the settlement policy of every engine runtime built from now on.
+ * `createEngineRuntime` reads it when its options name no policy, so a policy
+ * can be plugged in process-wide without touching a composition root. A
+ * runtime already built keeps the policy it was built with. The default is
+ * `defaultSettlementPolicy`.
+ */
+export function setSettlementPolicy(next: SettlementPolicy): void {
+	policy = next;
+}
+
+/** The policy `createEngineRuntime` hands its `StepSettledHandler` when its options name none. */
+export function getSettlementPolicy(): SettlementPolicy {
+	return policy;
+}
+
+/** Restore the default, `defaultSettlementPolicy`. */
+export function resetSettlementPolicy(): void {
+	policy = defaultSettlementPolicy;
+}
