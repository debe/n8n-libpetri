diff --git a/packages/core/src/execution-engine/scheduler-registry.ts b/packages/core/src/execution-engine/scheduler-registry.ts
new file mode 100644
index 00000000..bc50e933
--- /dev/null
+++ b/packages/core/src/execution-engine/scheduler-registry.ts
@@ -0,0 +1,29 @@
+import { StackScheduler } from './stack-scheduler';
+import type { WorkflowScheduler } from './workflow-scheduler';
+
+/** Creates the scheduler for one execution. */
+export type WorkflowSchedulerFactory = () => WorkflowScheduler;
+
+const defaultFactory: WorkflowSchedulerFactory = () => new StackScheduler();
+
+let factory = defaultFactory;
+
+/**
+ * Replace the scheduler every execution started from now on uses. This applies to
+ * `WorkflowExecute` instances constructed directly, as the runners and the tests do, so a
+ * different scheduler can be plugged in process-wide without touching any call site. The
+ * default is `StackScheduler`, n8n's execution loop.
+ */
+export function setWorkflowSchedulerFactory(next: WorkflowSchedulerFactory): void {
+	factory = next;
+}
+
+/** The factory `WorkflowExecute.processRunExecutionData()` calls once per execution. */
+export function getWorkflowSchedulerFactory(): WorkflowSchedulerFactory {
+	return factory;
+}
+
+/** Restore the default, `StackScheduler`. */
+export function resetWorkflowSchedulerFactory(): void {
+	factory = defaultFactory;
+}
