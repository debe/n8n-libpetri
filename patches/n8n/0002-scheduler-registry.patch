 .../execution-engine/scheduler-registry.ts    | 29 +++++++++++++++++++
 .../src/execution-engine/workflow-execute.ts  |  4 +--
 3 files changed, 37 insertions(+), 2 deletions(-)
 create mode 100644 packages/core/src/execution-engine/scheduler-registry.ts

